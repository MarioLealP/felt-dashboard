# felt-core's address on your network, e.g. http://192.168.10.110:8420
VITE_FELT_CORE_URL=

# WP-55: felt-core's API token (the server's FELT_API_TOKEN). Optional; a secret,
# local .env only - it ends up in your local dist/ build, never commit either.
VITE_FELT_CORE_TOKEN=

# felt-animation's local API (desktop-only, optional - if unset or
# unreachable, chat still works, she just won't react/lipsync to typed
# messages). Defaults to felt-animation's standard local port.
VITE_FELT_ANIMATION_URL=http://127.0.0.1:8421
