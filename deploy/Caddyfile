# Inside the felt-app container only: serve the built app at /app/.
{
	admin off
	auto_https off
}

:8080 {
	redir /app /app/ 308
	root * /srv
	# hashed build files never change; index.html must always be fresh
	header /app/assets/* Cache-Control "public, max-age=31536000, immutable"
	header /app/index.html Cache-Control "no-cache"
	header /app/ Cache-Control "no-cache"
	file_server
}
